# Firebase 웹 설정 (브라우저에서 씀 → NEXT_PUBLIC_ 붙임)
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹 앱) > SDK 설정 및 구성 에서 복사
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것 — 브라우저 번들에 들어가면 안 됨)

# 직원 로그인 코드(yymmdd) → 지점명. JSON 문자열 한 줄로.
# 예: {"250101":"수지점","250202":"구리점","250303":"운정점"}
STORE_CODES=

# 관리자 로그인 아이디/비밀번호
ADMIN_ID=
ADMIN_PASSWORD=

# 매장별 포스ID (4자리) → 매장 코드 로그인 후 추가로 확인하는 값. JSON 문자열 한 줄로.
# 예: {"수지점":"1004","구리점":"0000","운정점":"0000"}
STORE_POS_IDS=

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은
# JSON 파일 내용을 한 줄로 이어 붙여서 넣는다 (줄바꿈은 \n 그대로 두면 됨).
FIREBASE_SERVICE_ACCOUNT=
