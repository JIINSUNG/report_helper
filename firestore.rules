rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function role() {
      return request.auth.token.role;
    }
    function isSignedIn() {
      return request.auth != null && role() in ['admin', 'staff', 'guest'];
    }
    function isStaffOrAdmin() {
      return isSignedIn() && role() in ['admin', 'staff'];
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }
    function isGuest() {
      return isSignedIn() && role() == 'guest';
    }
    function isOwner(data) {
      return isStaffOrAdmin() && data.by == request.auth.uid;
    }
    function ownerUnchanged() {
      return request.resource.data.by == resource.data.by;
    }
    /** likes 필드만 바뀌는 업데이트인지 확인 (posts 좋아요용) */
    function onlyLikesChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }

    // 직원 이름 — 본인 문서만 읽기/쓰기, 관리자는 전체 조회 가능.
    // role/store는 로그인 API(Admin SDK)에서만 세팅되고 클라이언트는 바꿀 수 없다.
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isStaffOrAdmin() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('store', null) == resource.data.get('store', null);
      allow delete: if false;
    }

    // 제품 가격 오버라이드·경쟁 제품 비교 메모 — 직원 누구나 추가/수정,
    // hidden(단종 숨김) 변경과 삭제(문서 기본값 복원)는 관리자만.
    match /catalog/{productId} {
      allow read: if isSignedIn();
      allow create: if isStaffOrAdmin();
      allow update: if isStaffOrAdmin()
        && (isAdmin() || request.resource.data.get('hidden', false) == resource.data.get('hidden', false));
      allow delete: if isAdmin();
    }

    // 제품별 직원 세일즈 팁 — 본인 글만 수정, 삭제는 관리자만(직원은 삭제 요청).
    match /tips/{tipId} {
      allow read: if isSignedIn();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if isStaffOrAdmin() && isOwner(resource.data) && ownerUnchanged();
      allow delete: if isAdmin();
    }

    // 가격 변경 기록 — 수정할 때마다 자동으로 쌓이는 조회용 로그. 수정은 없고, 삭제는 관리자만.
    match /priceHistory/{entryId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 카테고리별 경쟁 제품 비교 — 팁과 동일한 권한 구조.
    match /rivals/{rivalId} {
      allow read: if isSignedIn();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if isStaffOrAdmin() && isOwner(resource.data) && ownerUnchanged();
      allow delete: if isAdmin();
    }

    // 매장 일정 — 직원 누구나 추가/수정(만든 사람 기록은 유지), 삭제는 관리자만.
    match /schedule/{eventId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if isStaffOrAdmin()
        && request.resource.data.by == resource.data.by
        && request.resource.data.get('created', null) == resource.data.get('created', null);
      allow delete: if isAdmin();
    }

    // 직원 공유방 글 — 게스트는 접근 불가. 좋아요(likes)만 바꾸는 업데이트는
    // 작성자가 아니어도 허용, 그 외 수정은 본인 글만. 삭제는 관리자만.
    match /posts/{postId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if isStaffOrAdmin()
        && ((isOwner(resource.data) && ownerUnchanged()) || onlyLikesChanged());
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if isStaffOrAdmin() && isOwner(resource.data) && ownerUnchanged();
      allow delete: if isAdmin();
    }

    // 삭제 요청 — 직원이 만들고(by 고정), 관리자가 처리(상태 변경)·삭제.
    // list도 직원까지 허용하는 이유: 직원이 "이미 요청했어요" 중복 방지 표시를 보려면
    // 같은 대상에 열려 있는 요청을 조회할 수 있어야 한다 (내용은 대상 id·라벨 정도로 민감하지 않음).
    match /delreq/{reqId} {
      allow get, list: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && request.resource.data.by == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
